# 이름만 적습니다. 실제 값은 GitHub Secrets / Vercel 환경 변수 / 이 PC 의 marketing/.env.local(git 제외)에만.

# 저장소 (사이트와 같은 Upstash Redis, 키는 todaygame:mkt:* 만 씀)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 채널 모드 (기본 mock — live 는 관리자가 직접 켬)
CHANNEL_MODE_INSTAGRAM=mock
CHANNEL_MODE_THREADS=mock
CHANNEL_MODE_FACEBOOK=mock
CHANNEL_MODE_YOUTUBE=mock

# 아래는 해당 PHASE 에서 씀
# BLOB_READ_WRITE_TOKEN=        PHASE 5 미디어 공개 주소 (Vercel Blob)
# TG_BOT_TOKEN=                 PHASE 5 텔레그램 승인
# TG_ADMIN_CHAT_ID=
# TG_WEBHOOK_SECRET=            웹훅으로 바꿀 때
# LLM_API_KEY=                  PHASE 4 문구 AI
# MKT_TOKEN_KEY=                PHASE 6 인스타 토큰 암호화 열쇠 (결정 5)
# INSTAGRAM_APP_SECRET=         PHASE 6 장기 토큰 교환
# MKT_ADMIN_KEY=                PHASE 9 웹 관리자
# FACEBOOK_PAGE_ID=             PHASE 8 Facebook 페이지 릴스 (페이지 토큰은 만료 없음)
# FACEBOOK_PAGE_TOKEN=
# YOUTUBE_CLIENT_ID=            PHASE 8 YouTube Shorts (OAuth 갱신 토큰)
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
# YOUTUBE_PRIVACY=public        처음 시험은 private
# GH_DISPATCH_TOKEN=            QStash 가 GitHub 실행을 깨울 때 (이 저장소 Actions 읽기·쓰기만, 이 PC · QStash 예약에만)
# QSTASH_TOKEN=                 Upstash QStash (예약 만들기 · 확인용)
# QSTASH_URL=                   지역 주소 (예: https://qstash-us-east-1.upstash.io)
# THREADS 토큰은 환경 변수가 아니라 저장소에 암호화 (run.js threads-connect, THREADS_NEW_TOKEN 으로 한 번만)
